{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "ignoreDeprecations": "6.0",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "typeRoots": [
      "./node_modules/",
      "./node_modules/@types/",
      "./types"
    ],
    "types": [
      "vite/client"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "scripts/**/*", "renderer/**/*", "pages/**/*", "components/**/*", "store/**/*"],
  "exclude": ["node_modules", "dist", "public/dist"]
}
